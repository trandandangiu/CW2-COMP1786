<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit_observation"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Observation -->
        <EditText
            android:id="@+id/etObservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/observation_text"
            android:inputType="textMultiLine"
            android:minHeight="48dp"
            android:autofillHints="text"
            android:gravity="top"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="12dp" />

        <!-- Time -->
        <EditText
            android:id="@+id/etTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/observation_time"
            android:inputType="datetime"
            android:autofillHints="time"
            android:focusable="false"
            android:clickable="true"
            android:padding="12dp"
            android:minHeight="48dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="12dp" />

        <!-- Comment -->
        <EditText
            android:id="@+id/etComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/observation_comment"
            android:inputType="textMultiLine"
            android:minHeight="48dp"
            android:autofillHints="text"
            android:gravity="top"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="24dp" />

        <!-- Save button -->
        <Button
            android:id="@+id/btnUpdateObservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_changes"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/teal_200"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <!-- Delete button -->
        <Button
            android:id="@+id/btnDeleteObservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delete_observation"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/holo_red_light"
            android:padding="14dp" />
    </LinearLayout>
</ScrollView>
