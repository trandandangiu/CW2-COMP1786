<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MHike_MAUI.MainPage"
             Title="🏔️ M-Hike Tracker"
             BackgroundColor="#F2F4F7">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 🔷 HEADER -->
        <Frame BackgroundColor="#007AFF" Padding="15" CornerRadius="0" HasShadow="False">
            <Label Text="M-Hike Tracker"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Frame>

        <!-- 📝 FORM -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <Label Text="📋 Hike Details"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1C1C1E"
                       HorizontalOptions="Center"/>

                <Frame Padding="16"
                       CornerRadius="20"
                       HasShadow="True"
                       BackgroundColor="White">

                    <VerticalStackLayout Spacing="12">

                        <!-- 🏞️ Name -->
                        <Entry x:Name="nameEntry"
                               Placeholder="Hike name *"
                               ClearButtonVisibility="WhileEditing"
                               FontSize="16"/>

                        <!-- 📍 Location -->
                        <Entry x:Name="locationEntry"
                               Placeholder="Location *"
                               ClearButtonVisibility="WhileEditing"
                               FontSize="16"/>

                        <!-- 📅 Date -->
                        <DatePicker x:Name="datePicker"
                                    Format="dd/MM/yyyy"
                                    FontSize="16"/>

                        <!-- 🚗 Parking -->
                        <Picker x:Name="parkingPicker"
                                Title="Parking available? *"
                                FontSize="16">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Yes</x:String>
                                    <x:String>No</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                        <!-- 📏 Length -->
                        <Entry x:Name="lengthEntry"
                               Placeholder="Length (km) *"
                               Keyboard="Numeric"
                               FontSize="16"/>

                        <!-- 🧭 Difficulty -->
                        <Picker x:Name="difficultyPicker"
                                Title="Difficulty *"
                                FontSize="16">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Easy</x:String>
                                    <x:String>Moderate</x:String>
                                    <x:String>Hard</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                        <!-- 📝 Description -->
                        <Editor x:Name="descriptionEditor"
                                Placeholder="Description (optional)"
                                AutoSize="TextChanges"
                                HeightRequest="100"
                                FontSize="16"/>

                        <!-- ☁️ Weather -->
                        <Entry x:Name="weatherEntry"
                               Placeholder="Weather condition"
                               FontSize="16"/>

                        <!-- ⛰️ Elevation -->
                        <Entry x:Name="elevationEntry"
                               Placeholder="Elevation (m)"
                               Keyboard="Numeric"
                               FontSize="16"/>

                        <!-- 📸 Add Photo -->
                        <Button Text="📸 Add Photo"
                                BackgroundColor="#FF9500"
                                TextColor="White"
                                CornerRadius="12"
                                FontAttributes="Bold"
                                Clicked="OnAddPhotoClicked"/>

                        <!-- 🖼️ Photo Preview (bo góc bằng Frame) -->
                        <Frame Padding="0"
                               HasShadow="False"
                               CornerRadius="16"
                               BorderColor="#E0E0E0"
                               IsVisible="{Binding Source={x:Reference photoPreview}, Path=IsVisible}">
                            <Image x:Name="photoPreview"
                                   HeightRequest="160"
                                   Aspect="AspectFill"
                                   Margin="0,8,0,0"
                                   IsVisible="False"
                                   HorizontalOptions="Center"
                                   WidthRequest="280"/>
                        </Frame>

                    </VerticalStackLayout>
                </Frame>

                <!-- 🟢 Result label -->
                <Label x:Name="resultLabel"
                       TextColor="#34C759"
                       FontAttributes="Italic"
                       FontSize="14"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 🧭 BOTTOM ACTION BUTTONS -->
        <Grid Grid.Row="2"
              Padding="15"
              ColumnDefinitions="*,*"
              BackgroundColor="White"
              RowSpacing="0">

            <Button x:Name="saveButton"
                    Text="💾 Save Hike"
                    Clicked="OnSaveClicked"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    Grid.Column="0"
                    HeightRequest="50"/>

            <Button x:Name="checkButton"
                    Text="🗂️ Check Saved"
                    Clicked="OnShowClicked"
                    BackgroundColor="#34C759"
                    TextColor="White"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    Grid.Column="1"
                    HeightRequest="50"/>
        </Grid>
    </Grid>
</ContentPage>
